<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: prevent cloud backup and device-to-device migration. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
